# Copy to `.env` and fill in. `.env` is gitignored.

# Google AI Studio key for the documentation assistant (the "Ask AI" button).
# Free tier, no card required: https://aistudio.google.com/apikey
#
# Read by `@ai-sdk/google` in server/routes/__docus__/assistant.post.ts.
# Without it the assistant answers 503 and everything else works as normal.
# Set the same variable in Vercel: Project Settings > Environment Variables.
GOOGLE_GENERATIVE_AI_API_KEY=
